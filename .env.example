# Postgres (Neon no Marketplace da Vercel preenche DATABASE_URL e/ou POSTGRES_URL)
DATABASE_URL=
POSTGRES_URL=

# Bearer da API /api/admin. Sem este valor, as rotas admin recusam todo mundo.
ADMIN_TOKEN=

# URL pública, usada no sitemap, no Open Graph e nos links da newsletter.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional. Os dois juntos inscrevem o e-mail na audiência da Resend.
# Sem eles, o cadastro fica só na tabela signups.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Opcional. Os três juntos enviam o formulário de /patrocinar para OWNER_EMAIL.
OWNER_EMAIL=
NOTIFY_FROM=
